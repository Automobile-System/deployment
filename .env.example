# Automobile Project - Environment Variables
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# Database Configuration (Neon PostgreSQL)
# Get these from: https://console.neon.tech -> Your Project -> Connection Details
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-NEON-HOST:5432/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_username
SPRING_DATASOURCE_PASSWORD=your_neon_password

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Secret Key (Generate a secure random string - at least 32 characters)
APP_SECURITY_JWT_SECRET_KEY=YourSecureRandomSecretKeyHere12345678901234567890

# CORS Configuration
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Frontend Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:8080
